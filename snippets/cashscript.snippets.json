{
  "Set Pragma": {
    "prefix": "pragma",
    "body": "pragma cashscript ^${1:0.14.0};\n",
    "description": "Set semantic version"
  },
  "Import Directive": {
    "prefix": "import",
    "body": "import \"${1:./functions.cash}\";\n",
    "description": "Import user-defined functions from another file (CashScript 0.14+)"
  },
  "Package Import Directive": {
    "prefix": "importpkg",
    "body": "import \"${1:package-name}/${2:functions.cash}\";\n",
    "description": "Import user-defined functions from an npm package in node_modules (CashScript 0.14+)"
  },
  "Instantiate a new Contract": {
    "prefix": "contract",
    "body": "contract ${1:ContractName}($2) {\n\n}",
    "description": "Creates a contract"
  },
  "Function Statement": {
    "prefix": "function",
    "body": "function ${1:functionName}(${2:params}) {\n\t$3\n}",
    "description": "Create function"
  },
  "Reusable Function": {
    "prefix": "rfunction",
    "body": "function ${1:functionName}(${2:params}) returns (${3:int}) {\n\treturn $4;\n}",
    "description": "Create a reusable top-level function with a return value (CashScript 0.14+)"
  },
  "Destructure Multiple Return Values": {
    "prefix": "destructure",
    "body": "${1:int} ${2:first}, ${3:int} ${4:second} = ${5:functionName}($6);",
    "description": "Destructure a multi-return function call into fresh variables (CashScript 0.14+)"
  },
  "Destructure Into Existing Variables": {
    "prefix": "reassign",
    "body": "(${1:first}, ${2:second}) = ${3:functionName}($4);",
    "description": "Destructure a multi-return function call into existing variables (CashScript 0.14+)"
  },
  "Global Constant": {
    "prefix": "constant",
    "body": "${1:int} constant ${2:CONSTANT_NAME} = ${3:value};\n",
    "description": "Declare a top-level global constant (CashScript 0.14+)"
  },
  "If Statement": {
    "prefix": "if",
    "body": "if (${1:condition}){\n\t$2\n}",
    "description": "If statement"
  },
  "If-Else statement": {
    "prefix": "ifelse",
    "body": "if (${1:condition}) {\n\t$2\n} else {\n\t$3\n}",
    "description": "if-else statement"
  },
  "For loop": {
    "prefix": "for",
    "body": "for (int ${1:i} = ${2:0}; ${1:i} < ${3:n}; ${1:i}++) {\n\t$4\n}",
    "description": "for loop"
  },
  "While loop": {
    "prefix": "while",
    "body": "while (${1:condition}) {\n\t$2\n}",
    "description": "while loop"
  },
  "Do-While loop": {
    "prefix": "dowhile",
    "body": "do {\n\t$1\n} while (${2:condition});",
    "description": "do-while loop"
  }
}
