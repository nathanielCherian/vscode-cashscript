// Emulates a CashScript library installed from npm as the `fibonacci` package
pragma cashscript ^0.14.0;

import "./constants.cash";

// Advances a Fibonacci pair by one step: the callers destructure the result back into the
// variables they passed in
function nextFib(int current, int next) returns (int, int) {
    return next, current + next;
}

function isWithinFibBounds(int value) returns (bool) {
    return value <= MAX_FIB;
}
